# Dedicated PostgreSQL development database. Use separate migration and runtime roles.
DATABASE_URL=postgresql://bennyc_runtime:CHANGE_ME@localhost:5432/bennyc_development
DIRECT_URL=postgresql://bennyc_migrator:CHANGE_ME@localhost:5432/bennyc_development
BETTER_AUTH_URL=http://localhost:3000
# Generate privately: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Dedicated demo database only. The seed refuses production or unconfirmed writes.
BENNYC_DEMO_DATA=true
SEED_DATABASE_NAME=bennyc_development

# Phase 2 signed server uploads; configure privately.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development-only checkout simulation; production always rejects it.
BENNYC_DEMO_CHECKOUT=false
