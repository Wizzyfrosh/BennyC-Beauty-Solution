generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StoreSettings {
  id            Int      @id @default(1)
  name          String   @default("BennyC Beauty Solution")
  descriptor    String   @default("Cosmetics & Makeup Venture")
  phone         String?
  email         String?
  whatsapp      String?
  pickupAddress String?  @map("pickup_address")
  timezone      String   @default("Africa/Lagos")
  currency      String   @default("NGN")
  demoData      Boolean  @default(false) @map("demo_data")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("store_settings")
}

// Generated by auth@1.7.7; business membership is a separate relation.
model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  staffMember        StaffMember?
  inventoryMovements InventoryMovement[]
  auditEvents        AuditEvent[]
  batchCosts         BatchCost[]
  recordedOrders     Order[]             @relation("OrderActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum StaffRole {
  OWNER @map("owner")
  STAFF @map("staff")
}

enum ProductStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum ImageProvider {
  LOCAL      @map("local")
  CLOUDINARY @map("cloudinary")
}

model StaffMember {
  userId    String    @id @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      StaffRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("staff_members")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique @db.VarChar(80)
  name      String    @db.VarChar(80)
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("categories")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug           String           @unique @db.VarChar(100)
  name           String           @db.VarChar(160)
  brand          String           @db.VarChar(80)
  description    String
  expiryRequired Boolean          @default(true) @map("expiry_required")
  status         ProductStatus    @default(DRAFT)
  isDemo         Boolean          @default(false) @map("is_demo")
  variants       ProductVariant[]
  images         ProductImage[]
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, categoryId])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id                String         @id @default(uuid()) @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  product           Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String         @unique @db.VarChar(80)
  optionValues      Json           @map("option_values")
  optionFingerprint String         @map("option_fingerprint") @db.VarChar(250)
  priceKobo         Int            @map("price_kobo")
  lowStockThreshold Int            @default(0) @map("low_stock_threshold")
  active            Boolean        @default(true)
  images            ProductImage[]
  batches           StockBatch[]
  orderItems        OrderItem[]
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([productId, optionFingerprint])
  @@unique([id, productId])
  @@index([productId, active])
  @@map("product_variants")
}

model ProductImage {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)
  provider  ImageProvider
  assetId   String          @map("asset_id")
  publicId  String?         @map("public_id")
  secureUrl String          @map("secure_url")
  version   Int?
  format    String
  width     Int
  height    Int
  altText   String          @map("alt_text")
  sortOrder Int             @default(0) @map("sort_order")
  demoTile  Int?            @map("demo_tile")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, assetId])
  @@index([productId, sortOrder])
  @@map("product_images")
}

enum ExpiryPrecision {
  DAY            @map("day")
  MONTH          @map("month")
  NOT_APPLICABLE @map("not_applicable")
}

enum MovementType {
  RECEIPT          @map("receipt")
  HANDOFF          @map("handoff")
  COUNT_ADJUSTMENT @map("count_adjustment")
  QUARANTINE       @map("quarantine")
  RELEASE          @map("release")
  WRITE_OFF        @map("write_off")
}

enum OperationState {
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
}

enum OrderChannel {
  WALK_IN  @map("walk_in")
  WHATSAPP @map("whatsapp")
  WEBSITE  @map("website")
}

enum PaymentStatus {
  UNPAID             @map("unpaid")
  PENDING            @map("pending")
  PAID               @map("paid")
  FAILED             @map("failed")
  PARTIALLY_REFUNDED @map("partially_refunded")
  REFUNDED           @map("refunded")
}

enum FulfilmentStatus {
  UNFULFILLED      @map("unfulfilled")
  PREPARING        @map("preparing")
  READY_FOR_PICKUP @map("ready_for_pickup")
  DISPATCHED       @map("dispatched")
  COMPLETED        @map("completed")
  CANCELLED        @map("cancelled")
}

enum PaymentProvider {
  MANUAL    @map("manual")
  PAYSTACK  @map("paystack")
  SIMULATED @map("simulated")
}

enum PaymentMode {
  LIVE      @map("live")
  TEST      @map("test")
  SIMULATED @map("simulated")
}

enum AttemptStatus {
  INITIALIZED @map("initialized")
  PENDING     @map("pending")
  SUCCEEDED   @map("succeeded")
  FAILED      @map("failed")
  ABANDONED   @map("abandoned")
}

model StockBatch {
  id               String              @id @default(uuid()) @db.Uuid
  variantId        String              @map("variant_id") @db.Uuid
  variant          ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  batchCode        String              @map("batch_code") @db.VarChar(100)
  receiptReference String              @map("receipt_reference") @db.VarChar(100)
  receivedAt       DateTime            @default(now()) @map("received_at") @db.Timestamptz
  expiryDate       DateTime?           @map("expiry_date") @db.Date
  expiryPrecision  ExpiryPrecision     @map("expiry_precision")
  expiryLabel      String?             @map("expiry_label") @db.VarChar(10)
  onHandQty        Int                 @default(0) @map("on_hand_qty")
  quarantinedQty   Int                 @default(0) @map("quarantined_qty")
  active           Boolean             @default(true)
  allocations      StockAllocation[]
  cost             BatchCost?
  movements        InventoryMovement[]
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([id, variantId])
  @@unique([variantId, batchCode, receiptReference])
  @@index([variantId, active, expiryDate])
  @@map("stock_batches")
}

model BatchCost {
  batchId      String     @id @map("batch_id") @db.Uuid
  batch        StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  unitCostKobo Int        @map("unit_cost_kobo")
  recordedBy   String     @map("recorded_by")
  actor        User       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  recordedAt   DateTime   @default(now()) @map("recorded_at") @db.Timestamptz

  @@map("batch_costs")
}

model IdempotencyRequest {
  id          String              @id @default(uuid()) @db.Uuid
  operation   String              @db.VarChar(80)
  actorScope  String              @map("actor_scope")
  keyHash     String              @map("key_hash") @db.VarChar(64)
  requestHash String              @map("request_hash") @db.VarChar(64)
  state       OperationState      @default(PROCESSING)
  response    Json?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  movements   InventoryMovement[]
  auditEvents AuditEvent[]
  order       Order?

  @@unique([operation, actorScope, keyHash])
  @@map("idempotency_requests")
}

model InventoryMovement {
  id              String             @id @default(uuid()) @db.Uuid
  batchId         String             @map("batch_id") @db.Uuid
  batch           StockBatch         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  orderItemId     String?            @map("order_item_id") @db.Uuid
  orderItem       OrderItem?         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  operationId     String             @map("operation_id") @db.Uuid
  operation       IdempotencyRequest @relation(fields: [operationId], references: [id], onDelete: Restrict)
  lineKey         String             @map("line_key")
  movementType    MovementType       @map("movement_type")
  onHandDelta     Int                @map("on_hand_delta")
  quarantineDelta Int                @map("quarantine_delta")
  reason          String             @db.VarChar(500)
  actorUserId     String             @map("actor_user_id")
  actor           User               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorType       String             @default("staff") @map("actor_type")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@unique([operationId, batchId, lineKey])
  @@index([batchId, createdAt])
  @@map("inventory_movements")
}

model AuditEvent {
  actorType   String             @default("staff") @map("actor_type")
  id          String             @id @default(uuid()) @db.Uuid
  actorUserId String?            @map("actor_user_id")
  actor       User?              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String             @db.VarChar(80)
  entityType  String             @map("entity_type") @db.VarChar(80)
  entityId    String             @map("entity_id")
  details     Json
  operationId String             @map("operation_id") @db.Uuid
  operation   IdempotencyRequest @relation(fields: [operationId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}

model Order {
  guestSessionId            String?            @map("guest_session_id") @db.Uuid
  guestSession              GuestSession?      @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  customerName              String?            @map("customer_name") @db.VarChar(120)
  customerEmail             String?            @map("customer_email") @db.VarChar(254)
  customerPhone             String?            @map("customer_phone") @db.VarChar(20)
  addressSnapshot           Json?              @map("address_snapshot")
  deliveryZoneId            String?            @map("delivery_zone_id") @db.Uuid
  deliveryZone              DeliveryZone?      @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  holdExpiresAt             DateTime?          @map("hold_expires_at") @db.Timestamptz
  exceptionCode             String?            @map("exception_code")
  accessTokens              OrderAccessToken[]
  id                        String             @id @default(uuid()) @db.Uuid
  orderNumber               String             @unique @map("order_number")
  channel                   OrderChannel
  currency                  String             @default("NGN")
  fulfilmentMethod          String             @default("pickup") @map("fulfilment_method")
  subtotalKobo              Int                @map("subtotal_kobo")
  deliveryFeeKobo           Int                @default(0) @map("delivery_fee_kobo")
  taxKobo                   Int                @default(0) @map("tax_kobo")
  totalKobo                 Int                @map("total_kobo")
  paymentStatus             PaymentStatus      @default(UNPAID) @map("payment_status")
  fulfilmentStatus          FulfilmentStatus   @default(UNFULFILLED) @map("fulfilment_status")
  confirmedPaymentAttemptId String?            @unique @map("confirmed_payment_attempt_id") @db.Uuid
  confirmedPayment          PaymentAttempt?    @relation("ConfirmedPayment", fields: [confirmedPaymentAttemptId], references: [id], onDelete: Restrict)
  paymentAttempts           PaymentAttempt[]   @relation("OrderAttempts")
  actorUserId               String?            @map("actor_user_id")
  actor                     User?              @relation("OrderActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  operationId               String             @unique @map("operation_id") @db.Uuid
  operation                 IdempotencyRequest @relation(fields: [operationId], references: [id], onDelete: Restrict)
  items                     OrderItem[]
  isDemo                    Boolean            @default(false) @map("is_demo")
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  paidAt                    DateTime?          @map("paid_at") @db.Timestamptz
  completedAt               DateTime?          @map("completed_at") @db.Timestamptz

  @@index([createdAt, channel])
  @@map("orders")
}

model OrderItem {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @map("order_id") @db.Uuid
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId           String              @map("variant_id") @db.Uuid
  variant             ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productNameSnapshot String              @map("product_name_snapshot")
  skuSnapshot         String              @map("sku_snapshot")
  optionsSnapshot     Json                @map("options_snapshot")
  unitPriceKobo       Int                 @map("unit_price_kobo")
  quantity            Int
  lineTotalKobo       Int                 @map("line_total_kobo")
  movements           InventoryMovement[]
  allocations         StockAllocation[]

  @@unique([id, variantId])
  @@index([orderId])
  @@map("order_items")
}

model PaymentAttempt {
  id                 String          @id @default(uuid()) @db.Uuid
  orderId            String          @map("order_id") @db.Uuid
  order              Order           @relation("OrderAttempts", fields: [orderId], references: [id], onDelete: Restrict)
  confirmedOrder     Order?          @relation("ConfirmedPayment")
  provider           PaymentProvider
  paymentMode        PaymentMode     @map("payment_mode")
  method             String          @db.VarChar(30)
  providerReference  String?         @map("provider_reference") @db.VarChar(150)
  amountKobo         Int             @map("amount_kobo")
  currency           String          @default("NGN")
  status             AttemptStatus
  verificationMethod String          @map("verification_method")
  verifiedAt         DateTime?       @map("verified_at") @db.Timestamptz
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, providerReference])
  @@unique([id, orderId])
  @@index([orderId])
  @@map("payment_attempts")
}

model GuestSession {
  checkoutIntents CheckoutIntent[]
  id              String           @id @default(uuid()) @db.Uuid
  tokenHash       String           @unique @map("token_hash") @db.VarChar(64)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  orders          Order[]

  @@map("guest_sessions")
}

model DeliveryZone {
  id                  String  @id @default(uuid()) @db.Uuid
  name                String  @db.VarChar(100)
  state               String  @db.VarChar(80)
  localGovernmentArea String  @map("local_government_area") @db.VarChar(100)
  areas               Json
  feeKobo             Int     @map("fee_kobo")
  active              Boolean @default(true)
  orders              Order[]

  @@map("delivery_zones")
}

enum AllocationState {
  HELD      @map("held")
  COMMITTED @map("committed")
  RELEASED  @map("released")
  CONSUMED  @map("consumed")
}

model StockAllocation {
  id            String          @id @default(uuid()) @db.Uuid
  orderItemId   String          @map("order_item_id") @db.Uuid
  batchId       String          @map("batch_id") @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  item          OrderItem       @relation(fields: [orderItemId, variantId], references: [id, variantId], onDelete: Restrict)
  batch         StockBatch      @relation(fields: [batchId, variantId], references: [id, variantId], onDelete: Restrict)
  quantity      Int
  state         AllocationState @default(HELD)
  expiresAt     DateTime?       @map("expires_at") @db.Timestamptz
  releaseReason String?         @map("release_reason")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([batchId, state, expiresAt])
  @@index([orderItemId])
  @@map("stock_allocations")
}

model OrderAccessToken {
  id        String    @id @default(uuid()) @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  kind      String    @db.VarChar(10)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([orderId])
  @@map("order_access_tokens")
}

model CheckoutIntent {
  id             String       @id @default(uuid()) @db.Uuid
  guestSessionId String       @map("guest_session_id") @db.Uuid
  guestSession   GuestSession @relation(fields: [guestSessionId], references: [id], onDelete: Restrict)
  request        Json
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([guestSessionId])
  @@map("checkout_intents")
}
